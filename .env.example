# Local development:
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Railway PostgreSQL testing:
# APP_ENV=development
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# OWNER_ID=
# MANAGER_IDS=

# Railway production after real managers are ready:
# APP_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# OWNER_ID=
# MANAGER_IDS=id1,id2,id3,id4,id5,id6,id7,id8,id9,id10,id11

BOT_TOKEN=
OPENROUTER_API_KEY=
OWNER_ID=
MANAGER_IDS=

DEFAULT_MODEL=deepseek/deepseek-v4-flash:free
OPENROUTER_APP_NAME=Company Support Bot
OPENROUTER_SITE_URL=

AI_HISTORY_LIMIT=12
AI_STREAMING_ENABLED=true
AI_STREAM_UPDATE_INTERVAL_SECONDS=0.8
AI_STREAM_MIN_CHARS=80
AI_STREAM_USE_TELEGRAM_DRAFT=true
LOG_LEVEL=INFO

INSTAGRAM_URL=
OFFICIAL_SITE_URL=
BROADCAST_RATE_PER_SECOND=20

# Telegram Mini App Configuration:
# In production, set a unique 32+ character secret and the exact deployed Mini App origin.
MINIAPP_SESSION_SECRET=dev_secret_change_me_in_production
MINIAPP_AUTH_MAX_AGE_SECONDS=86400
MINIAPP_ORIGIN=http://localhost:5173
MINIAPP_URL=
